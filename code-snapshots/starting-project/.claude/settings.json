{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun run format 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@anthropic-plugin-directory": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
